# Backend local. Loaded when started from the project root or backend/.
# Plain KEY=value, without quotes (Spring reads this as a properties file).
PORT=8079
DATABASE_URL=jdbc:h2:file:./data/carona;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USER=sa
DATABASE_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
GEOCODING_URL=https://nominatim.openstreetmap.org/search
ROUTING_URL=https://router.project-osrm.org
MAPS_USER_AGENT=Carona-Solidaria/1.0 (corporate carpool)
