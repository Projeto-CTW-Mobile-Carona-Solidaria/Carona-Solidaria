        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Volume por nível",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "carona-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (rate({job=\"carona-backend\",application=\"carona-solidaria\",environment=\"local\",level=~\"${level:regex}\"} |~ ${search:doublequote} | json | requestId =~ ${request_id:doublequote} | __error__=\"\" [$__auto]))",
          "datasource": {
            "type": "loki",
            "uid": "carona-loki"
          },
          "legendFormat": "{{level}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Logs da aplicação",
      "description": "Expanda um evento para ver mensagem, rota, status HTTP, duração e requestId. A rota usa o template do controlador, sem IDs pessoais.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "carona-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"carona-backend\",application=\"carona-solidaria\",environment=\"local\",level=~\"${level:regex}\"} |~ ${search:doublequote} | json | requestId =~ ${request_id:doublequote} | __error__=\"\"",
          "datasource": {
            "type": "loki",
            "uid": "carona-loki"
          },
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 6,
      "title": "Somente avisos e erros",
      "description": "",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "carona-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"carona-backend\",application=\"carona-solidaria\",environment=\"local\",level=~\"${level:regex}\"} |~ ${search:doublequote} | json | requestId =~ ${request_id:doublequote} | __error__=\"\" | level=~\"WARN|ERROR\"",
          "datasource": {
            "type": "loki",
            "uid": "carona-loki"
          },
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
