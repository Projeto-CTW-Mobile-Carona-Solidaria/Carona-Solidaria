{
  "uid": "carona-api",
  "title": "Carona Solidária · API e JVM",
  "description": "Disponibilidade, tráfego, erros, latência, JVM e pool de conexões. Métricas reais do Spring Boot Actuator. Histogramas HTTP incluem buckets para p95 e p99.",
  "tags": [
    "carona-solidaria",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "title": "API e JVM",
      "type": "link",
      "url": "/d/carona-api",
      "keepTime": true
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/carona-logs",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instância",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "carona-prometheus"
        },
        "query": "label_values(up{job=\"carona-backend\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "API disponível",
      "description": "1: todas as instâncias selecionadas respondem à coleta. 0: pelo menos uma coleta falhou; consulte Targets no Prometheus.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "carona-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"carona-backend\",instance=~\"$instance\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "carona-prometheus"
          },
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "INDISPONÍVEL",
                  "color": "red"
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Requisições por segundo",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "carona-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"carona-backend\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "carona-prometheus"
          },
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Erros HTTP 5xx",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "carona-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"carona-backend\",instance=~\"$instance\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"carona-backend\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval])), 0.000001)",
          "datasource": {
            "type": "prometheus",
            "uid": "carona-prometheus"
          },
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Latência p95",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "carona-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"carona-backend\",instance=~\"$instance\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "carona-prometheus"
          },
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
